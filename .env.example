# Copie para .env e preencha. O .env não vai para o git.

# ── Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Modelo e esforço. Fixe antes do experimento: mudar aqui muda o config_hash.
INDAGA_MODELO=claude-opus-5-5
INDAGA_ESFORCO=medium
# Deixe vazio no Opus 5.5 (o modelo rejeita temperature).
INDAGA_TEMPERATURA=
# Preço USD por milhão de tokens. Vazio = usa a tabela em indaga/config.py.
INDAGA_PRECO_ENTRADA=
INDAGA_PRECO_SAIDA=

# ── Supabase / PostgreSQL ───────────────────────────────────────────────
# Supabase > Project Settings > Database > Connection string > Session pooler.
# Conexão administrativa (usuário postgres): carga, esquema e log.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Mesma URL, trocando o usuário por indaga_leitor.SEU_PROJETO e a senha
# pela definida em banco/01_estrutura.sql. É quem executa o SQL da IA.
DATABASE_URL_LEITURA=postgresql://indaga_leitor.SEU_PROJETO:SENHA_DO_LEITOR@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# ── Acesso ──────────────────────────────────────────────────────────────
# Senha da interface. Vazia = interface aberta.
INDAGA_SENHA_ACESSO=
# Teto de consultas da interface nas últimas 24 h (padrão 100). Não afeta a avaliação.
INDAGA_LIMITE_DIARIO=
