/// Dimensão calendário (data da compra). Tabela calculada em DAX.
table dCalendario
	lineageTag: d5c7f89a-5b7c-52be-87ff-b24262e8cfbe
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 14b9cd9d-2e68-57b5-ac70-08ad019aa9a4
		summarizeBy: none
		sourceColumn: [Data]

		annotation SummarizationSetBy = User

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 8d82154c-a4de-54cb-9f2c-aeebc015a658
		summarizeBy: none
		sourceColumn: [Ano]

		annotation SummarizationSetBy = User

	column Semestre
		dataType: string
		lineageTag: 61ee8f48-e46b-51c2-87e5-fe81315838fb
		summarizeBy: none
		sourceColumn: [Semestre]

		annotation SummarizationSetBy = User

	column Trimestre
		dataType: string
		lineageTag: c5967ffb-1008-5697-b93a-3a9b776df74f
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = User

	column 'Mês número'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 87610618-8b80-591f-8908-1417a4561940
		summarizeBy: none
		sourceColumn: [Mês número]

		annotation SummarizationSetBy = User

	column Mês
		dataType: string
		lineageTag: 93f555dd-0f10-5431-90cb-d8d477def336
		summarizeBy: none
		sourceColumn: [Mês]
		sortByColumn: 'Mês número'

		annotation SummarizationSetBy = User

	column Ano-mês
		dataType: string
		lineageTag: 8293ebf0-5b57-5120-b4f9-eb89fb45ccb3
		summarizeBy: none
		sourceColumn: [Ano-mês]

		annotation SummarizationSetBy = User

	partition dCalendario = calculated
		mode: import
		source =
				VAR datas = SELECTCOLUMNS(CALENDAR(DATE(2016, 1, 1), DATE(2018, 12, 31)), "Data", [Date])
				RETURN
				    ADDCOLUMNS(
				        datas,
				        "Ano", YEAR([Data]),
				        "Semestre", IF(MONTH([Data]) <= 6, "1º semestre", "2º semestre"),
				        "Trimestre", "T" & QUARTER([Data]),
				        "Mês número", MONTH([Data]),
				        "Mês", SWITCH(MONTH([Data]), 1, "jan", 2, "fev", 3, "mar", 4, "abr", 5, "mai", 6, "jun", 7, "jul", 8, "ago", 9, "set", 10, "out", 11, "nov", 12, "dez"),
				        "Ano-mês", FORMAT([Data], "yyyy-mm")
				    )

	annotation PBI_Id = 96487a19a5795e5e8e4005dbd26f4d5a

